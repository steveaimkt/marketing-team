{
  "description": "실적 원장을 점검하고 AI 마케터의 실행 전 승인과 저장 경로를 강제한다.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger-stats.mjs\" --hook 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "실적 원장 점검"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|Agent|Task|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "AI 마케터 실행 승인과 저장 경로를 확인하는 중"
          }
        ]
      }
    ]
  }
}
