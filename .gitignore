.DS_Store
node_modules/

# 출판 전략 메모 — 제품이 아니다. Public 전환 시 새어 나가면 안 된다
codex/

# .claude/ 는 저장소에 넣지 않는다 — 심링크가 서버 검증(failed_content)과 윈도우 클론 양쪽에서 걸린다.
# 폴더로 열어 쓸 때는 「팀 점검하자」가 이 폴더를 만들어 준다.
.claude/

# 작업 폴더는 저장소에 넣지 않는다 — 「팀 점검하자」가 만들어 준다.
# 템플릿 정본은 plugins/marketing-team/brand-templates/ 한 곳뿐이다 (중복이 있으면 조용히 어긋난다).
brand/
logs/
outputs/
inputs/

# 사용자가 꺼내 본 카탈로그 사본 (정본은 plugins/…/100-skills/카탈로그.html)
마케팅-스킬-100.html

